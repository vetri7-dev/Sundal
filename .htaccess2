DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files/directories directly (assets, images, fonts)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to our root index.php
    RewriteRule ^ index.php [L]
</IfModule>

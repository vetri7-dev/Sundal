<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the requested file exists inside public/ serve it directly
    RewriteCond %{DOCUMENT_ROOT}/sundal/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Everything else goes through Laravel's index.php
    RewriteRule ^ public/index.php [L]
</IfModule>
